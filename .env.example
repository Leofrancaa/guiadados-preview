# Acesso padrão da demonstração (envie aos convidados). Sem definir, vale
# convidado / guiadados2026.
DEMO_USUARIO=convidado
DEMO_SENHA=

# Sessão do login: 32+ caracteres aleatórios (openssl rand -base64 48).
AUTH_SECRET=

# IA (chat, insights e resumo). Só no servidor: NUNCA use prefixo NEXT_PUBLIC_.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
GROQ_API_KEY=
GROQ_MODEL=

# Limites diários do chat (protegem o custo da IA): por IP e total.
DEMO_LIMITE_CHAT_IP=20
DEMO_LIMITE_CHAT_DIA=200
